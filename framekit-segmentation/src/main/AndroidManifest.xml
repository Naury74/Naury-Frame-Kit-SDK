<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- FrameKit 편집기가 이 값으로 배경 제거 구현을 찾는다. -->
        <meta-data
            android:name="com.naury.framekit.BACKGROUND_REMOVER"
            android:value="com.naury.framekit.segmentation.MlKitBackgroundRemover" />
        <!-- 첫 사용 때 기다리지 않도록 앱 설치 시점에 Play 서비스가 모델을 내려받게 한다. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />
    </application>

</manifest>
