    "track_sound_mp4_only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton wird nur in MP4 gespeichert. GIF kann keinen Ton enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound is saved only in MP4. GIF can't contain sound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido solo se guarda en MP4. GIF no puede contener sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son n'est enregistré qu'en MP4. Les GIF ne peuvent pas contenir de son."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara hanya disimpan dalam MP4. GIF tidak bisa berisi suara."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はMP4で保存したときだけ含まれます。GIFには音声を入れられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 MP4로 저장할 때만 담겨요. GIF에는 소리를 넣을 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som só é salvo em MP4. GIF não pode ter som."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук сохраняется только в MP4. GIF не может содержать звук."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะถูกบันทึกเฉพาะไฟล์ MP4 เท่านั้น GIF ใส่เสียงไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh chỉ được lưu khi lưu dưới dạng MP4. GIF không chứa được âm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有保存为 MP4 时才包含声音，GIF 无法包含声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有儲存為 MP4 時才包含聲音，GIF 無法包含聲音。"
          }
        }
      }
    },
