    "motion_format_webp_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräftigere Farben und kleiner als GIF. Manche Apps unterstützen es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Richer colors and smaller than GIF. Some apps may not support it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colores más ricos y más pequeño que un GIF. Algunas apps pueden no admitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleurs plus riches et plus léger qu'un GIF. Certaines applis peuvent ne pas le prendre en charge."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna lebih kaya dan lebih kecil daripada GIF. Beberapa aplikasi mungkin tidak mendukungnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFより色が豊かで小さくなります。一部のアプリは対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF보다 색이 풍부하고 작아요. 일부 앱은 지원하지 않을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cores mais ricas e menor que o GIF. Alguns apps podem não ser compatíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Богаче цветами и меньше, чем GIF. Некоторые приложения могут не поддерживать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีสมบูรณ์กว่าและเล็กกว่า GIF บางแอปอาจไม่รองรับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu phong phú hơn và nhỏ hơn GIF. Một số ứng dụng có thể không hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色彩比 GIF 更丰富且更小。部分应用可能不支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "色彩比 GIF 更豐富且更小。部分應用程式可能不支援。"
          }
        }
      }
    },
