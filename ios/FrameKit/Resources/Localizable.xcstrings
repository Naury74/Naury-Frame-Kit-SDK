    "mask_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe über das Video, um einen Bereich abzudecken. Er wird ab der Abspielposition 3 Sekunden lang verdeckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag on the video to cover an area. It hides that area for 3 seconds from the playhead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra sobre el video para cubrir un área. Se oculta durante 3 segundos desde el cabezal de reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser sur la vidéo pour couvrir une zone. Elle est masquée pendant 3 secondes à partir de la tête de lecture."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret di video untuk menutupi area. Area itu disembunyikan selama 3 detik dari posisi putar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の上をドラッグして隠す範囲を指定します。再生位置から3秒間隠れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상 위를 끌어 가릴 영역을 지정하세요. 재생 위치부터 3초 동안 가려져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste sobre o vídeo para cobrir uma área. Ela fica oculta por 3 segundos a partir do cursor de reprodução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по видео, чтобы закрыть область. Она скрывается на 3 секунды от текущей позиции."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากบนวิดีโอเพื่อปิดบังพื้นที่ พื้นที่นั้นจะถูกปิดบัง 3 วินาทีนับจากตำแหน่งที่เล่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo trên video để che một vùng. Vùng đó sẽ bị che trong 3 giây kể từ vị trí phát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在视频上拖动以遮挡区域，将从播放位置起遮挡 3 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在影片上拖曳以遮蔽區域，將從播放位置起遮蔽 3 秒。"
          }
        }
      }
    },
