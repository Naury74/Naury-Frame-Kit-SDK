    "document_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Ecken an die Seitenränder und wende es dann an, um die Seite zu begradigen."
          }
        },
        "en": {
