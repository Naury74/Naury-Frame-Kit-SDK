    "motion_format_gif_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt sich fast überall öffnen. Nur 256 Farben, daher einfachere Farben und größere Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens almost everywhere. Limited to 256 colors and larger files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre casi en cualquier lugar. Solo 256 colores, así que los colores son más simples y el archivo es mayor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ouvre presque partout. Seulement 256 couleurs : couleurs simplifiées et fichier plus lourd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisa dibuka hampir di mana saja. Hanya 256 warna sehingga warna lebih sederhana dan file lebih besar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほぼどこでも開けます。256色のため色が単純になり、ファイルが大きくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 모든 곳에서 열려요. 256색이라 색이 단순해지고 파일이 커요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre em quase todo lugar. Só 256 cores, então as cores ficam mais simples e o arquivo maior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывается почти везде. Всего 256 цветов, поэтому цвета проще, а файл больше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดได้แทบทุกที่ มีเพียง 256 สี สีจึงเรียบง่ายลงและไฟล์ใหญ่ขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở được hầu như ở mọi nơi. Chỉ 256 màu nên màu đơn giản hơn và tệp lớn hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几乎所有地方都能打开。仅 256 色，颜色较简单且文件较大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幾乎所有地方都能開啟。僅 256 色，顏色較簡單且檔案較大。"
          }
        }
      }
    },
