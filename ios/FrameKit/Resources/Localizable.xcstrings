        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากมุมไปที่ขอบกระดาษ แล้วกดใช้เพื่อปรับให้เรียบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo các góc đến mép trang giấy, rồi áp dụng để làm phẳng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
