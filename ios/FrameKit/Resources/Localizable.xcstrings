    "document_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Ecken an die Seitenränder und wende es dann an, um die Seite zu begradigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the corners to the edges of the page, then apply to flatten it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las esquinas a los bordes de la página y aplica para enderezarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les coins vers les bords de la page, puis appliquez pour la redresser."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret sudut ke tepi halaman, lalu terapkan untuk meratakannya."
