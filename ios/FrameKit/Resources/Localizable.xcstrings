    "motion_loop_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumerang spielt bis zum Ende und dann rückwärts zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boomerang plays to the end and then back in reverse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bumerán se reproduce hasta el final y luego vuelve al revés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le boomerang lit jusqu'à la fin puis revient à l'envers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolak-balik diputar sampai akhir lalu kembali secara terbalik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブーメランは最後まで再生したあと逆再生で戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부메랑은 끝까지 간 뒤 거꾸로 돌아와요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bumerangue toca até o fim e depois volta ao contrário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бумеранг проигрывается до конца, а затем обратно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บูมเมอแรงจะเล่นจนจบแล้วเล่นย้อนกลับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Qua lại sẽ phát đến cuối rồi phát ngược trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来回播放会先播到结尾，再倒放回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來回播放會先播到結尾，再倒轉回來。"
          }
        }
      }
    },
    "motion_motion_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Foto zoomt oder schwenkt langsam. Automatisch wechselt den Effekt bei jedem Foto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each photo slowly zooms or pans. Auto alternates for every photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada foto se acerca o se desplaza lentamente. Automático alterna el efecto en cada foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque photo zoome ou se déplace lentement. Auto alterne l'effet pour chaque photo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap foto diperbesar atau digeser perlahan. Otomatis bergantian untuk setiap foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ごとにゆっくりズームまたは移動します。自動は写真ごとに動きを変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진마다 천천히 확대하거나 이동해요. 자동은 사진마다 번갈아 움직여요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada foto aproxima ou se move devagar. O automático alterna o efeito em cada foto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое фото медленно приближается или сдвигается. «Авто» чередует эффекты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแต่ละรูปจะซูมหรือเลื่อนช้าๆ อัตโนมัติจะสลับการเคลื่อนไหวให้แต่ละรูป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi ảnh phóng to hoặc lia chậm. Tự động sẽ luân phiên cho từng ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张照片缓慢放大或平移。自动会为每张照片轮流选择效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每張相片緩慢放大或平移。自動會為每張相片輪流選擇效果。"
          }
        }
      }
    },
