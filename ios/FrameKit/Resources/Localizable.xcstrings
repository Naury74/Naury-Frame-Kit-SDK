            "value": "Mikrofon tidak dapat digunakan. Mungkin sedang dipakai aplikasi lain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを使用できません。他のアプリが使用中の可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 쓸 수 없어요. 다른 앱이 쓰고 있을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível usar o microfone. Outro app pode estar usando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось использовать микрофон. Возможно, он занят другим приложением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไมโครโฟนไม่ได้ แอปอื่นอาจกำลังใช้อยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không dùng được micrô. Có thể ứng dụng khác đang dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用麦克风，可能有其他应用正在使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用麥克風，可能有其他應用程式正在使用。"
          }
        }
      }
    },
    "voice_permission_denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aufnehmen wird die Mikrofonberechtigung benötigt. Du kannst sie in den Einstellungen erteilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
