    "timeline_full": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr hinzuzufügen würde das Video länger als erlaubt machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding more would make the video longer than allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si añades más, el video superará la duración permitida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ajouter davantage dépasserait la durée autorisée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan lagi akan membuat video lebih panjang dari batas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これ以上追加すると動画が上限より長くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 붙이면 허용된 길이를 넘어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar mais deixaria o vídeo mais longo que o permitido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если добавить ещё, видео станет длиннее допустимого."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากเพิ่มอีก วิดีโอจะยาวเกินกว่าที่อนุญาต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm nữa sẽ khiến video dài hơn mức cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续添加会使视频超出允许的时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續新增會使影片超過允許的長度。"
          }
        }
      }
    },
