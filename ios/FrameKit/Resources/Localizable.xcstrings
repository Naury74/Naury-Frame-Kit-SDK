    "cutout_model_failed_network": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download nicht möglich, da keine Internetverbindung besteht. Prüfe die Verbindung und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't download because you're offline. Check your connection and try again."
