        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音やファイルは再生位置に追加されます。クリップをタップすると編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음과 파일은 재생 위치에 들어가요. 조각을 누르면 편집할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravações e arquivos são adicionados no cursor. Toque em um clipe para editar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи и файлы добавляются в позицию курсора. Нажмите на клип, чтобы изменить его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงที่อัดและไฟล์จะถูกเพิ่มที่หัวเล่น แตะคลิปเพื่อแก้ไข"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi và tệp được thêm tại đầu phát. Chạm vào đoạn để chỉnh sửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音和文件会添加到播放头位置。点按片段即可编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音和檔案會加入到播放頭位置。輕觸片段即可編輯。"
