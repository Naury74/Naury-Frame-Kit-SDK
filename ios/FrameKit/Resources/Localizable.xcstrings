    "draft_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du sie nicht anwendest, gehen nur die eben in %1$@ gemachten Änderungen verloren. Frühere Bearbeitungen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't apply them, only what you just changed in %1$@ will be lost. Earlier edits stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no los aplicas, solo se perderá lo que acabas de cambiar en %1$@. Las ediciones anteriores se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous ne les appliquez pas, seules les modifications faites à l'instant dans %1$@ seront perdues. Les retouches précédentes sont conservées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tidak diterapkan, hanya perubahan terbaru di %1$@ yang hilang. Edit sebelumnya tetap ada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用しない場合、%1$@で今変更した内容だけが失われます。それより前の編集はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용하지 않으면 방금 %1$@에서 바꾼 내용만 사라져요. 그 전에 한 편집은 그대로예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se não aplicar, só o que você acabou de mudar em %1$@ será perdido. As edições anteriores continuam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если не применить, пропадут только последние изменения в разделе «%1$@». Предыдущие правки сохранятся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่ใช้ จะเสียเฉพาะสิ่งที่เพิ่งเปลี่ยนใน %1$@ เท่านั้น การแก้ไขก่อนหน้ายังอยู่ครบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không áp dụng, chỉ những gì bạn vừa thay đổi trong %1$@ sẽ bị mất. Các chỉnh sửa trước đó vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不应用，只会丢失刚才在%1$@中的更改，之前的编辑会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不套用，只會遺失剛才在%1$@中的變更，先前的編輯會保留。"
          }
        }
      }
    },
    "draft_title": {
