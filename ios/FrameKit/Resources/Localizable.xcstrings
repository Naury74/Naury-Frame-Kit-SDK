    "document_applied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokument begradigt. Zuschnitt, Text, Sticker, Zeichnungen und Masken wurden zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Document flattened. Crop, text, stickers, drawing and masks were reset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Documento enderezado. Se restablecieron el recorte, el texto, los stickers, los dibujos y las áreas ocultas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Document redressé. Le recadrage, le texte, les autocollants, les dessins et les masques ont été réinitialisés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen diratakan. Pangkas, teks, stiker, gambar, dan sensor telah diatur ulang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類を補正しました。切り抜き・テキスト・ステッカー・描画・マスクはリセットされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서를 반듯하게 폈어요. 자르기·텍스트·스티커·그리기·가리기는 초기화했어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Documento endireitado. Corte, texto, figurinhas, desenhos e áreas ocultas foram redefinidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документ выровнен. Обрезка, текст, стикеры, рисунки и скрытие сброшены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับเอกสารให้เรียบแล้ว การครอบตัด ข้อความ สติกเกอร์ ภาพวาด และการปิดบังถูกรีเซ็ต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã làm phẳng tài liệu. Cắt, chữ, nhãn dán, hình vẽ và vùng che đã được đặt lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拉平文档。裁剪、文字、贴纸、绘图和遮挡已重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拉平文件。裁切、文字、貼圖、繪圖和遮蔽已重設。"
          }
        }
      }
    },
    "document_batch_skipped": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einigen Seiten wurde kein Dokument gefunden; sie bleiben unverändert. Öffne sie, um die Ecken selbst festzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some pages had no document found and were left as they are. Open them to set the corners yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En algunas páginas no se encontró ningún documento y se dejaron como estaban. Ábrelas para ajustar las esquinas tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun document n'a été trouvé sur certaines pages, elles sont restées telles quelles. Ouvrez-les pour placer les coins vous-même."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa halaman tidak terdeteksi dokumennya dan dibiarkan apa adanya. Buka halaman tersebut untuk mengatur sudutnya sendiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類が見つからなかったページはそのままにしました。そのページで角を手動で合わせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서를 찾지 못한 쪽은 그대로 두었어요. 해당 쪽에서 모서리를 직접 맞춰 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas páginas não tinham documento detectado e ficaram como estavam. Abra-as para ajustar os cantos manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На некоторых страницах документ не найден, они оставлены без изменений. Откройте их, чтобы задать углы вручную."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บางหน้าไม่พบเอกสารจึงคงไว้ตามเดิม เปิดหน้านั้นเพื่อปรับมุมด้วยตนเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số trang không tìm thấy tài liệu nên được giữ nguyên. Hãy mở các trang đó để tự căn góc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分页面未找到文档，已保持原样。请在这些页面中手动调整四角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分頁面找不到文件，已維持原樣。請在這些頁面中手動調整四角。"
          }
        }
      }
    },
