    "privacy_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unschärfe lässt sich manchmal rückgängig machen. Nutze für persönliche Daten das Mosaik."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blur can sometimes be reversed. Use mosaic for personal information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desenfoque a veces se puede revertir. Usa mosaico para datos personales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flou peut parfois être inversé. Utilisez la mosaïque pour les informations personnelles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Efek buram terkadang bisa dikembalikan. Gunakan mosaik untuk informasi pribadi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼかしは元に戻せる場合があります。個人情報にはモザイクをおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블러는 복원될 수 있어요. 개인정보는 모자이크를 권장해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desfoque às vezes pode ser revertido. Use mosaico para informações pessoais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размытие иногда можно обратить. Для личных данных используйте мозаику."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพเบลออาจถูกกู้คืนได้ในบางกรณี ใช้โมเสกสำหรับข้อมูลส่วนตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng làm mờ đôi khi có thể bị khôi phục. Hãy dùng khảm cho thông tin cá nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊有时可被还原。个人信息建议使用马赛克。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊有時可被還原。個人資料建議使用馬賽克。"
          }
        }
      }
    },
