    "sticker_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticker erscheinen ab der Abspielposition 3 Sekunden lang. Zum Verschieben ziehen; mit zwei Fingern Größe und Drehung ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stickers show for 3 seconds from the playhead. Drag to move; use two fingers to resize or rotate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los stickers se muestran durante 3 segundos desde el cabezal. Arrastra para moverlos; usa dos dedos para cambiar el tamaño o girarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autocollants s'affichent 3 secondes à partir de la tête de lecture. Faites glisser pour déplacer ; utilisez deux doigts pour redimensionner ou pivoter."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiker tampil selama 3 detik dari posisi putar. Seret untuk memindahkan; gunakan dua jari untuk mengubah ukuran atau memutar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステッカーは再生位置から3秒間表示されます。ドラッグで移動、2本指でサイズや角度を変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스티커는 재생 위치부터 3초 동안 보여요. 끌어서 옮기고 두 손가락으로 크기와 각도를 바꿔요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As figurinhas aparecem por 3 segundos a partir do cursor. Arraste para mover; use dois dedos para redimensionar ou girar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стикеры видны 3 секунды от текущей позиции. Перетаскивайте, чтобы переместить; двумя пальцами — менять размер и поворот."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สติกเกอร์จะแสดง 3 วินาทีนับจากตำแหน่งที่เล่น ลากเพื่อย้าย ใช้สองนิ้วเพื่อปรับขนาดหรือหมุน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhãn dán hiển thị trong 3 giây kể từ vị trí phát. Kéo để di chuyển; dùng hai ngón tay để đổi kích thước hoặc xoay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贴纸会从播放位置起显示 3 秒。拖动可移动，双指可缩放或旋转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼圖會從播放位置起顯示 3 秒。拖曳可移動，雙指可縮放或旋轉。"
          }
        }
      }
    },
