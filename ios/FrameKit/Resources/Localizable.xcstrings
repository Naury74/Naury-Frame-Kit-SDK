    "cutout_model_metered_warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nutzt gerade mobile Daten. Je nach Tarif können Kosten entstehen, daher wird WLAN empfohlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're on mobile data. Charges may apply depending on your plan, so Wi-Fi is recommended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás usando datos móviles. Podrían aplicarse cargos según tu plan, así que te recomendamos usar Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous utilisez les données mobiles. Des frais peuvent s'appliquer selon votre forfait : nous vous conseillons le Wi-Fi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang memakai data seluler. Biaya mungkin berlaku sesuai paket Anda, jadi sebaiknya gunakan Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在モバイルデータを使用しています。ご契約のプランによっては料金が発生するため、Wi-Fi でのダウンロードをおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 모바일 데이터를 사용 중이에요. 요금제에 따라 데이터 요금이 발생할 수 있으니 Wi-Fi에서 받는 것을 권장해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está usando dados móveis. Pode haver cobrança conforme seu plano, por isso recomendamos o Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы используете мобильный интернет. В зависимости от тарифа может взиматься плата, поэтому рекомендуем Wi-Fi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้คุณใช้อินเทอร์เน็ตมือถืออยู่ อาจมีค่าบริการตามแพ็กเกจ แนะนำให้ดาวน์โหลดผ่าน Wi-Fi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang dùng dữ liệu di động. Có thể phát sinh phí tùy gói cước, nên tải qua Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您正在使用移动数据。根据您的套餐可能会产生流量费用，建议使用 Wi-Fi 下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前正在使用行動數據。依你的資費方案可能會產生數據費用，建議使用 Wi-Fi 下載。"
          }
        }
      }
    },
    "cutout_model_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst weiter bearbeiten. Wenn du die App schließt, wird der Download beim nächsten Mal fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep editing. If you close the app, the download continues next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seguir editando. Si cierras la app, la descarga continuará la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer à modifier. Si vous fermez l'application, le téléchargement reprendra la prochaine fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda bisa terus mengedit. Jika aplikasi ditutup, unduhan dilanjutkan lain kali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集を続けても大丈夫です。アプリを閉じても次回に続きからダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 편집을 계속해도 돼요. 앱을 닫아도 다음에 이어서 받아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode continuar editando. Se fechar o app, o download continua na próxima vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно продолжать редактирование. Если закрыть приложение, загрузка продолжится в следующий раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขต่อได้เลย หากปิดแอป จะดาวน์โหลดต่อในครั้งถัดไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể tiếp tục chỉnh sửa. Nếu đóng ứng dụng, lần sau sẽ tải tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以继续编辑。即使关闭应用，下次也会继续下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以繼續編輯。即使關閉應用程式，下次也會繼續下載。"
          }
        }
      }
    },
