    "motion_sticker_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Element im Bild, um es auszuwählen, und ziehe es zum Verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap an item on the image to select it, then drag to move it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un elemento de la imagen para seleccionarlo y arrástralo para moverlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un élément de l'image pour le sélectionner, puis faites-le glisser."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk item pada gambar untuk memilih, lalu seret untuk memindahkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像上の項目をタップして選び、ドラッグで移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 위 항목을 눌러 고르고, 끌어서 옮겨요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um item da imagem para selecionar e arraste para mover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на элемент на изображении, чтобы выбрать, и перетащите его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะรายการบนภาพเพื่อเลือก แล้วลากเพื่อย้าย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào mục trên ảnh để chọn, rồi kéo để di chuyển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按图片上的项目来选择，拖动即可移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕觸圖片上的項目來選取，拖曳即可移動。"
          }
        }
      }
    },
