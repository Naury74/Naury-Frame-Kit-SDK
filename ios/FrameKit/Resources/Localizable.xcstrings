    "canvas_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips mit anderem Seitenverhältnis werden mit schwarzen Balken eingepasst oder füllen das Bild und verlieren ihre Ränder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips with a different shape are fitted with black bars, or fill the frame and lose their edges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips con otra proporción se ajustan con barras negras, o rellenan el cuadro y pierden los bordes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips d'un autre format sont ajustés avec des bandes noires, ou remplissent le cadre en perdant leurs bords."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip dengan bentuk berbeda dipaskan dengan bilah hitam, atau memenuhi bingkai dengan tepi terpotong."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形の異なるクリップは、黒い余白を付けて収めるか、端を切って画面を埋めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모양이 다른 클립은 검은 여백을 두고 맞추거나, 가장자리를 잘라 화면을 채워요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipes com outro formato são ajustados com barras pretas ou preenchem o quadro e perdem as bordas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клипы другой формы вписываются с чёрными полосами или заполняют кадр с обрезкой краёв."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิปที่มีสัดส่วนต่างกันจะถูกปรับให้พอดีพร้อมแถบดำ หรือขยายเต็มเฟรมโดยขอบบางส่วนถูกตัดออก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clip có tỷ lệ khác sẽ được thêm viền đen cho vừa, hoặc lấp đầy khung và bị cắt mép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比例不同的片段会加黑边以适应画面，或裁掉边缘以填满画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比例不同的片段會加上黑邊以符合畫面，或裁掉邊緣以填滿畫面。"
          }
        }
      }
    },
