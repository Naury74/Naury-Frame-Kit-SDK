    "motion_format_mp4_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste Qualität und kleinste Datei. Läuft in den meisten Apps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best quality and smallest file. Plays in most apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mejor calidad y el archivo más pequeño. Se reproduce en casi todas las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleure qualité et fichier le plus léger. Lisible dans la plupart des applis."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kualitas terbaik dan file terkecil. Dapat diputar di sebagian besar aplikasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画質が最も良く、ファイルが小さくなります。ほとんどのアプリで再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화질이 가장 좋고 파일이 작아요. 대부분의 앱에서 재생돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhor qualidade e menor arquivo. Toca na maioria dos apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшее качество и самый маленький файл. Воспроизводится в большинстве приложений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณภาพดีที่สุดและไฟล์เล็กที่สุด เล่นได้ในแอปส่วนใหญ่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chất lượng tốt nhất, tệp nhỏ nhất. Phát được trên hầu hết ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画质最好，文件最小，大多数应用都能播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫質最好，檔案最小，大多數應用程式都能播放。"
          }
        }
      }
    },
