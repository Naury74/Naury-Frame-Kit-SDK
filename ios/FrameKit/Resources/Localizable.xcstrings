    "audio_tools_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahmen und Dateien werden am Abspielkopf eingefügt. Tippe auf einen Clip, um ihn zu bearbeiten."
          }
