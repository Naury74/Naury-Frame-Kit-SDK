    "speed_too_long": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesem Tempo wird das Video länger als erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This speed makes the video longer than allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esta velocidad, el video supera la duración permitida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette vitesse, la vidéo dépasse la durée autorisée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecepatan ini membuat video lebih panjang dari batas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この速度では動画が上限より長くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 속도로는 허용된 길이보다 길어져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com esta velocidade, o vídeo fica mais longo que o permitido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С такой скоростью видео станет длиннее допустимого."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความเร็วนี้ทำให้วิดีโอยาวเกินกว่าที่อนุญาต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với tốc độ này, video sẽ dài hơn mức cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此速度会使视频超出允许的时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此速度會使影片超過允許的長度。"
          }
        }
      }
    },
    "speed_too_short": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesem Tempo wird das Video kürzer als erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This speed makes the video shorter than allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esta velocidad, el video queda por debajo de la duración permitida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette vitesse, la vidéo est plus courte que la durée autorisée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecepatan ini membuat video lebih pendek dari batas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この速度では動画が下限より短くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 속도로는 허용된 길이보다 짧아져요."
          }
        },
        "pt-BR": {
