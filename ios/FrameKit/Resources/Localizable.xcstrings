    "sound_timeline_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügte Töne erscheinen in der Zeitleiste. Tippe auf ein Stück, um es zu teilen, zu verschieben, zu kürzen oder einzublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added sounds appear on the timeline. Tap a piece there to split, move, trim or fade it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos añadidos aparecen en la línea de tiempo. Toca un fragmento para dividirlo, moverlo, recortarlo o añadir fundidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons ajoutés apparaissent sur la timeline. Touchez un morceau pour le diviser, le déplacer, le couper ou ajouter un fondu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara yang ditambahkan muncul di linimasa. Ketuk potongan untuk memisahkan, memindahkan, memangkas, atau memberi fade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加した音声はタイムラインに表示されます。タップして分割・移動・カット・フェードができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넣은 소리는 타임라인에 나타나요. 조각을 눌러 나누기·옮기기·자르기·페이드를 할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sons adicionados aparecem na linha do tempo. Toque em um trecho para dividir, mover, cortar ou aplicar fade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавленные звуки показаны на шкале времени. Нажмите на фрагмент, чтобы разделить, переместить, обрезать или задать затухание."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงที่เพิ่มจะแสดงบนไทม์ไลน์ แตะชิ้นเสียงเพื่อแยก ย้าย ตัด หรือเฟด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh đã thêm hiển thị trên dòng thời gian. Chạm vào một đoạn để tách, di chuyển, cắt hoặc làm mờ dần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加的声音会显示在时间轴上，点按片段即可分割、移动、裁剪或淡入淡出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增的聲音會顯示在時間軸上，輕觸片段即可分割、移動、裁剪或淡入淡出。"
          }
        }
      }
    },
