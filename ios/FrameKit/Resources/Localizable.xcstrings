        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "四隅をページの端に合わせて適用すると、まっすぐに補正されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모서리를 종이 끝에 맞추고 적용하면 반듯하게 펴져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os cantos até as bordas da página e aplique para endireitá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите углы к краям страницы и нажмите «Применить», чтобы выровнять её."
