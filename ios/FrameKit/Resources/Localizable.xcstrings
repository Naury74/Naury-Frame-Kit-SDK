    "split_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kann nicht geteilt werden. Gehe etwas weg vom Clip-Rand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't split here. Move a little away from the clip edge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede dividir aquí. Aléjate un poco del borde del clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de diviser ici. Éloignez-vous un peu du bord du clip."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membagi di sini. Geser sedikit menjauh dari tepi klip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは分割できません。クリップの端から少し離してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 나눌 수 없어요. 클립 경계에서 조금 떨어진 곳으로 옮겨 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível dividir aqui. Afaste-se um pouco da borda do clipe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь разделить нельзя. Отойдите немного от края клипа."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยกตรงนี้ไม่ได้ โปรดเลื่อนออกจากขอบคลิปเล็กน้อย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tách tại đây. Hãy di chuyển ra xa mép clip một chút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此处分割。请稍微远离片段边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在此處分割。請稍微遠離片段邊緣。"
          }
        }
      }
    },
