    "cutout_model_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das KI-Modell zur Motiverkennung wird einmalig über die Google Play-Dienste heruntergeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI model that finds the subject is downloaded once through Google Play services."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de IA que encuentra el sujeto se descarga una sola vez a través de los servicios de Google Play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d'IA qui détecte le sujet est téléchargé une seule fois via les services Google Play."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model AI untuk menemukan subjek diunduh sekali melalui layanan Google Play."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "被写体を見つける AI モデルを Google Play 開発者サービスから一度だけダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피사체를 찾는 AI 모델을 Google Play 서비스에서 한 번만 내려받아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de IA que encontra o objeto principal é baixado uma única vez pelo Google Play Services."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ-модель для поиска объекта загружается один раз через сервисы Google Play."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดล AI ที่ใช้หาวัตถุหลักจะดาวน์โหลดผ่านบริการ Google Play เพียงครั้งเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình AI tìm chủ thể sẽ được tải một lần qua Dịch vụ Google Play."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于识别主体的 AI 模型将通过 Google Play 服务下载，只需下载一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來辨識主體的 AI 模型會透過 Google Play 服務下載，只需下載一次。"
          }
        }
      }
    },
    "cutout_model_data_warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne WLAN werden mobile Daten verwendet, wodurch Kosten entstehen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you're not on Wi-Fi, mobile data will be used and charges may apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no estás conectado a Wi-Fi, se usarán datos móviles y podrían aplicarse cargos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous n'êtes pas connecté au Wi-Fi, les données mobiles seront utilisées et des frais peuvent s'appliquer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tidak terhubung ke Wi-Fi, data seluler akan digunakan dan mungkin dikenai biaya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi に接続していない場合はモバイルデータを使用し、料金が発生することがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi에 연결되어 있지 않으면 모바일 데이터가 사용되어 요금이 발생할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você não estiver no Wi-Fi, os dados móveis serão usados e poderá haver cobrança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы не подключены к Wi-Fi, будет использован мобильный интернет, и может взиматься плата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่ได้เชื่อมต่อ Wi-Fi จะใช้อินเทอร์เน็ตมือถือและอาจมีค่าบริการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không dùng Wi-Fi, dữ liệu di động sẽ được sử dụng và có thể phát sinh phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果未连接 Wi-Fi，将使用移动数据，可能会产生费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果未連上 Wi-Fi，將使用行動數據，可能會產生費用。"
          }
        }
      }
    },
    "cutout_model_dialog_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst es nur einmal herunterladen. Danach wird der Hintergrund direkt auf deinem Gerät entfernt – auch offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You only need to download it once. After that, backgrounds are removed on your device, even offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hay que descargarlo una vez. Después, el fondo se quita en tu dispositivo, incluso sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul téléchargement suffit. Ensuite, l'arrière-plan est supprimé sur votre appareil, même hors connexion."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cukup unduh sekali. Setelah itu, latar dihapus di perangkat Anda, bahkan saat offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードは最初の一度だけです。その後はオフラインでも端末内で背景を削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 한 번만 받으면 그다음부터는 인터넷 없이도 기기 안에서 배경을 지울 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é preciso baixar uma vez. Depois disso, o fundo é removido no próprio dispositivo, mesmo off-line."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка нужна только один раз. После этого фон удаляется прямо на устройстве, даже без интернета."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดแค่ครั้งแรกครั้งเดียว หลังจากนั้นลบพื้นหลังในเครื่องได้แม้ไม่มีอินเทอร์เน็ต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần tải một lần. Sau đó bạn có thể xóa nền ngay trên thiết bị, kể cả khi không có mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需下载一次，之后即使没有网络也能在设备上移除背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需下載一次，之後即使沒有網路也能在裝置上移除背景。"
          }
        }
      }
    },
    "cutout_model_dialog_title": {
      "extractionState": "manual",
      "localizations": {
