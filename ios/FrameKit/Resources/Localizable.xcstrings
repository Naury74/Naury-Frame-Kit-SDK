    "partially_restored": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien konnten nicht geöffnet werden. Die Bearbeitung wird ohne sie fortgesetzt."
          }
        },
        "en": {
