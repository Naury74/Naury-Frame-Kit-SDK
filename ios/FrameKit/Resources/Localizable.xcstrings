    "motion_audio_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügte Töne erscheinen unter dem Player. Tippe auf ein Stück, um es zu teilen, zu verschieben, zu kürzen oder einzublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds you add appear in the lanes under the player. Tap a piece to split, move, trim or fade it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos añadidos aparecen bajo el reproductor. Toca un fragmento para dividirlo, moverlo, recortarlo o añadir fundidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons ajoutés apparaissent sous le lecteur. Touchez un morceau pour le diviser, le déplacer, le couper ou ajouter un fondu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara yang ditambahkan muncul di bawah pemutar. Ketuk potongan untuk memisahkan, memindahkan, memangkas, atau memberi fade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加した音声はプレーヤーの下に表示されます。タップして分割・移動・カット・フェードができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넣은 소리는 재생 줄 아래에 나타나요. 조각을 눌러 나누기·옮기기·자르기·페이드를 할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sons adicionados aparecem abaixo do player. Toque em um trecho para dividir, mover, cortar ou aplicar fade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавленные звуки показаны под проигрывателем. Нажмите на фрагмент, чтобы разделить, переместить, обрезать или задать затухание."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงที่เพิ่มจะแสดงใต้แถบเล่น แตะชิ้นเสียงเพื่อแยก ย้าย ตัด หรือเฟด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh đã thêm hiển thị bên dưới thanh phát. Chạm vào một đoạn để tách, di chuyển, cắt hoặc làm mờ dần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加的声音会显示在播放条下方，点按片段即可分割、移动、裁剪或淡入淡出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增的聲音會顯示在播放列下方，輕觸片段即可分割、移動、裁剪或淡入淡出。"
          }
        }
      }
    },
