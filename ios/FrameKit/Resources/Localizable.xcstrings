    "draw_shapes_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Zeichnen über das Foto ziehen. Tippe auf eine Form, um sie zu verschieben, ihre Größe oder ihren Stil zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag on the photo to draw. Tap a shape to move, resize or restyle it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra sobre la foto para dibujar. Toca una forma para moverla, cambiar su tamaño o su estilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser sur la photo pour dessiner. Touchez une forme pour la déplacer, la redimensionner ou changer son style."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret di atas foto untuk menggambar. Ketuk bentuk untuk memindahkan, mengubah ukuran, atau gayanya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の上をドラッグして描きます。描いた図形をタップすると移動やサイズ・スタイルの変更ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 위를 끌어 그리세요. 그린 도형을 누르면 옮기거나 크기·모양을 바꿀 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste sobre a foto para desenhar. Toque em uma forma para movê-la, redimensioná-la ou mudar o estilo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по фото, чтобы нарисовать. Нажмите на фигуру, чтобы переместить её, изменить размер или стиль."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากบนรูปเพื่อวาด แตะรูปทรงที่วาดแล้วเพื่อย้าย ปรับขนาด หรือเปลี่ยนรูปแบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo trên ảnh để vẽ. Chạm vào hình để di chuyển, đổi kích thước hoặc kiểu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在照片上拖动即可绘制。点按已绘制的形状可移动、调整大小或修改样式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在相片上拖曳即可繪製。點一下已繪製的形狀可移動、調整大小或變更樣式。"
          }
        }
      }
    },
    "error_camera_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kamera-App verfügbar. Wähle stattdessen ein Foto oder Video."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera app is available. Choose a photo or video instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna app de cámara disponible. Elige una foto o un video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app d'appareil photo disponible. Choisissez plutôt une photo ou une vidéo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada aplikasi kamera. Pilih foto atau video saja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用できるカメラアプリがありません。写真または動画を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 수 있는 카메라 앱이 없어요. 사진이나 영상을 골라 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app de câmera disponível. Escolha uma foto ou um vídeo."
          }
        },
        "ru": {
          "stringUnit": {
