    "cutout_model_metered_warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nutzt gerade mobile Daten. Je nach Tarif können Kosten entstehen, daher wird WLAN empfohlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're on mobile data. Charges may apply depending on your plan, so Wi-Fi is recommended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás usando datos móviles. Podrían aplicarse cargos según tu plan, así que te recomendamos usar Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous utilisez les données mobiles. Des frais peuvent s'appliquer selon votre forfait : nous vous conseillons le Wi-Fi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang memakai data seluler. Biaya mungkin berlaku sesuai paket Anda, jadi sebaiknya gunakan Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在モバイルデータを使用しています。ご契約のプランによっては料金が発生するため、Wi-Fi でのダウンロードをおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 모바일 데이터를 사용 중이에요. 요금제에 따라 데이터 요금이 발생할 수 있으니 Wi-Fi에서 받는 것을 권장해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está usando dados móveis. Pode haver cobrança conforme seu plano, por isso recomendamos o Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы используете мобильный интернет. В зависимости от тарифа может взиматься плата, поэтому рекомендуем Wi-Fi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้คุณใช้อินเทอร์เน็ตมือถืออยู่ อาจมีค่าบริการตามแพ็กเกจ แนะนำให้ดาวน์โหลดผ่าน Wi-Fi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang dùng dữ liệu di động. Có thể phát sinh phí tùy gói cước, nên tải qua Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您正在使用移动数据。根据您的套餐可能会产生流量费用，建议使用 Wi-Fi 下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前正在使用行動數據。依你的資費方案可能會產生數據費用，建議使用 Wi-Fi 下載。"
          }
        }
      }
    },
    "cutout_model_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
