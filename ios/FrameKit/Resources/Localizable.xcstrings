          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso permitir o microfone para gravar. Você pode permitir nas Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для записи нужно разрешение на микрофон. Его можно дать в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้สิทธิ์ไมโครโฟนเพื่ออัดเสียง อนุญาตได้ในการตั้งค่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền micrô để ghi âm. Bạn có thể cho phép trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音需要麦克风权限，可在设置中允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
