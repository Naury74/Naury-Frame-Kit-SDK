<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            debug 빌드 전용. 배경 제거 모델이 없는 상태를 시험하려고 adb로 모델 상태를 보거나 해제를 요청한다.
            adb shell am broadcast -n com.naury.framekit.showcase/.debug.ModelDebugReceiver -a com.naury.framekit.showcase.debug.MODEL -e op status|release
        -->
        <receiver
            android:name=".debug.ModelDebugReceiver"
            android:exported="true"
            android:process=":framekit_segmentation">
            <intent-filter>
                <action android:name="com.naury.framekit.showcase.debug.MODEL" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
